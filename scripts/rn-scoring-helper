// ==UserScript==
// @name         rn-scoring-helper
// @namespace    http://tampermonkey.net/
// @version      0.9
// @description  Returns focus to Quick Find, sorts/filters penalty codes, and sets per-code penalty basis defaults.
// @author       Paul Leonard vibin w Gemini and ChatGPT
// @match        https://www.regattanetwork.com/clubmgmt/mgmt_score_edit_beta.php?*
// @grant        none
// ==/UserScript==

(function() {
    'use strict';

    // ================= USER SETTINGS =================
    // These are startup defaults. Page checkboxes reset to them on reload.
    // 1. Keyboard entry
    let autoFocusQuickFind = true;

    // 2. Scoring defaults
    // Enable only when the NOR/SIs invoke A5.3 and RN check-ins represent boats
    // that came to the starting area. This sets defaults, not scoring rules.
    let useAppendixA53 = false;
    // Optional per-code overrides, applied AFTER the preset. Examples:
    // DNF: 'F1', DNS: 'C1', DNC: ''
    // '' = Competitors +1; F1/F2/F3 = Finishers +1/+2/+3;
    // C1/C2 = Checkins +1/+2. Only count-based codes below accept overrides.
    const penaltyBasisOverrides = {};

    // 3. Penalty menu: exact codes to grey out; [] enables all.
    // A currently selected code remains enabled to preserve its value.
    const disabledPenaltyCodes = ['BYE', 'RET-BF', 'RET-AF'];

    // ============== INTERNAL PAGE INTEGRATION ==============
    // No configuration needed below this line.

    // The name of the input field to focus on.
    const targetFieldName = 'pattern1';
    // The CSS selector for the target field.
    const targetFieldSelector = `input[name="${targetFieldName}"]`;

    const disabledCodes = new Set(disabledPenaltyCodes);
    const watchedSelection = new WeakSet();
    const originalDisabled = new WeakMap();
    function refreshDisabledOptions(select) {
        for (const option of select.options) {
            if (!originalDisabled.has(option)) originalDisabled.set(option, option.disabled);
            const disabled = originalDisabled.get(option) ||
                (option.value !== '' && disabledCodes.has(option.value) && !option.selected);
            if (option.disabled !== disabled) option.disabled = disabled;
        }
    }
    function watchSelection(element, properties, select) {
        if (watchedSelection.has(element)) return;
        watchedSelection.add(element);
        for (const property of properties) {
            const descriptor = Object.getOwnPropertyDescriptor(Object.getPrototypeOf(element), property);
            if (!descriptor?.get || !descriptor?.set || Object.hasOwn(element, property)) continue;
            Object.defineProperty(element, property, {
                configurable: true,
                get() { return descriptor.get.call(this); },
                set(value) {
                    descriptor.set.call(this, value);
                    refreshDisabledOptions(select);
                }
            });
        }
    }
    const penaltySelector = 'select#comment';
    const penaltyBasisDefaults = {
        DNC: '', DNS: '', OCS: '', UFD: '', BFD: '', 'BFD-DNE': '',
        NSC: '', DNF: '', RET: '', 'RET-BF': '', 'RET-AF': '',
        DSQ: '', DNE: '', DGM: ''
    };
    if (useAppendixA53) {
        for (const code of Object.keys(penaltyBasisDefaults)) {
            if (code !== 'DNC') penaltyBasisDefaults[code] = 'C1';
        }
    }
    const validBases = new Set(['', 'F1', 'F2', 'F3', 'C1', 'C2']);
    for (const [code, basis] of Object.entries(penaltyBasisOverrides)) {
        if (Object.hasOwn(penaltyBasisDefaults, code) && validBases.has(basis)) {
            penaltyBasisDefaults[code] = basis;
        } else {
            console.warn('RN helper: ignored invalid penalty basis override:', code, basis);
        }
    }

    // Bubble after RN's inline checkPenalty() handler. Apply only on code
    // selection, never during DOM refreshes, so manual basis edits survive.
    // Delegation also handles replacement menus. Programmatic callers can
    // dispatch a bubbling change event when starting a new penalty entry.
    function applyPenaltyBasis(code) {
        const basisField = document.querySelector('select[name="penalty_basis"]');
        if (!basisField) return;
        // Clear stale hidden bases for NONE and codes using other inputs.
        const basis = Object.hasOwn(penaltyBasisDefaults, code) ? penaltyBasisDefaults[code] : '';
        if (Array.from(basisField.options).some(option => option.value === basis && !option.disabled)) {
            basisField.value = basis;
        } else {
            basisField.value = '';
            console.warn('RN helper: configured penalty basis unavailable:', code, basis);
        }
    }
    document.addEventListener('change', event => {
        if (event.target.matches?.(penaltySelector)) {
            refreshDisabledOptions(event.target);
            applyPenaltyBasis(event.target.value);
        }
    });

    function ensureA53Switch(select) {
        if (document.getElementById('rn-helper-a53')) return;
        const label = document.createElement('label');
        label.id = 'rn-helper-a53-control';
        label.className = 'rn-helper-control';
        label.title = 'Use only when the NOR/SIs invoke A5.3 and check-ins represent boats at the starting area. Per-code overrides still apply. Resets on page reload.';
        const toggle = document.createElement('input');
        toggle.type = 'checkbox';
        toggle.id = 'rn-helper-a53';
        toggle.checked = useAppendixA53;
        toggle.addEventListener('change', () => {
            useAppendixA53 = toggle.checked;
            for (const code of Object.keys(penaltyBasisDefaults)) {
                penaltyBasisDefaults[code] = Object.hasOwn(penaltyBasisOverrides, code) && validBases.has(penaltyBasisOverrides[code])
                    ? penaltyBasisOverrides[code]
                    : useAppendixA53 && code !== 'DNC' ? 'C1' : '';
            }
            const current = document.querySelector(penaltySelector);
            if (current) applyPenaltyBasis(current.value);
        });
        label.append(toggle, ' Use A5.3 defaults');
        select.after(label);
    }
    const filterStyle = document.createElement('style');
    // Blue identifies the helper's controls; disabled options remain readable.
    filterStyle.textContent = `
        .rn-helper-control {
            display: block;
            width: fit-content;
            margin: 5px 0;
            padding: 3px 7px;
            border-left: 2px solid #80acd4;
            border-radius: 3px;
            background: #f0f6fc;
            color: #245d8f;
            font: normal 12px/1.5 Arial, sans-serif;
            cursor: pointer;
        }
        .rn-helper-control input[type="checkbox"] {
            accent-color: #3276b1;
            vertical-align: middle;
            margin: 0 5px 0 0;
        }
        select#comment {
            color: #245d8f;
            background-color: #f0f6fc;
            border: 1px solid #80acd4;
            border-radius: 3px;
        }
        select#comment option:disabled {
            color: #888;
            background-color: #f3f3f3;
        }
    `;
    (document.head || document.documentElement).appendChild(filterStyle);

    function updatePenaltyOptions() {
        ensureFocusSwitch();
        const select = document.querySelector(penaltySelector);
        if (!select) return;
        ensureA53Switch(select);

        const options = Array.from(select.options);
        const selectedOption = options[select.selectedIndex];
        const sorted = options.slice().sort((a, b) => {
            if (a.value === b.value) return 0;
            if (a.value === '') return -1; // NONE always first.
            if (b.value === '') return 1;
            return a.value < b.value ? -1 : 1;
        });

        watchSelection(select, ['value', 'selectedIndex'], select);
        for (const option of options) watchSelection(option, ['selected'], select);
        if (sorted.some((option, index) => option !== options[index])) {
            // Move the original options, preserving labels and other attributes.
            select.append(...sorted);
            select.selectedIndex = selectedOption ? sorted.indexOf(selectedOption) : -1;
        }
        refreshDisabledOptions(select);
    }

    // Focus only after a completed left-to-right transfer, not arbitrary edits.
    let focusTimer;
    function cancelFocus() {
        clearTimeout(focusTimer);
    }
    function queueFocus() {
        cancelFocus();
        if (!autoFocusQuickFind) return;
        focusTimer = setTimeout(() => {
            const field = document.querySelector(targetFieldSelector);
            if (autoFocusQuickFind && field?.isConnected && !field.disabled &&
                field.getClientRects().length && getComputedStyle(field).visibility !== 'hidden') {
                field.focus();
            }
        }, 0);
    }
    // A deliberate interaction after a transfer takes priority over queued focus.
    for (const event of ['pointerdown', 'keydown', 'focusin']) {
        document.addEventListener(event, cancelFocus, true);
    }

    function ensureFocusSwitch() {
        const field = document.querySelector(targetFieldSelector);
        if (!field) return;
        // Keep RN's inline Move Selected link on the input's original line.
        const next = field.nextElementSibling;
        const anchor = next?.matches('span') && next.querySelector('a');
        const placement = anchor && anchor.textContent.trim() === 'Move Selected' ? next : field;
        const existing = document.getElementById('rn-helper-autofocus');
        if (existing) {
            if (placement.nextElementSibling !== existing.parentElement) placement.after(existing.parentElement);
            return;
        }
        const label = document.createElement('label');
        label.className = 'rn-helper-control';
        const toggle = document.createElement('input');
        toggle.type = 'checkbox';
        toggle.id = 'rn-helper-autofocus';
        toggle.checked = autoFocusQuickFind;
        toggle.addEventListener('change', () => {
            autoFocusQuickFind = toggle.checked;
            cancelFocus();
        });
        label.append(toggle, ' Auto-focus Quick Find');
        label.title = 'Return to Quick Find after scoring a boat. Turn off for corrections. Resets on page reload.';
        placement.after(label);
    }

    function listCounts() {
        const unscored = document.querySelector('select[name="first_list"]');
        const scored = Array.from(document.querySelectorAll('select[name^="ordered_list_"]'))
            .filter(select => /^ordered_list_\d+(\[\])?$/.test(select.name));
        const count = select => Array.from(select.options).filter(option => option.value !== 'temp').length;
        return unscored && scored.length
            ? { unscored: count(unscored), scored: scored.reduce((sum, select) => sum + count(select), 0) }
            : null;
    }
    let previousCounts;
    const observer = new MutationObserver(() => {
        const current = listCounts();
        if (previousCounts && current && current.scored > previousCounts.scored &&
            current.unscored < previousCounts.unscored) {
            queueFocus();
        } else if (previousCounts && current && current.scored < previousCounts.scored) {
            cancelFocus();
        }
        previousCounts = current;
        observer.disconnect();
        try {
            updatePenaltyOptions();
        } finally {
            observer.observe(document.body, { childList: true, subtree: true });
        }
    });
    function initialize() {
        updatePenaltyOptions();
        previousCounts = listCounts();
        observer.observe(document.body, { childList: true, subtree: true });
        // Initial convenience only when the user has not already focused a field.
        if (document.activeElement === document.body) queueFocus();
    }
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initialize, { once: true });
    } else {
        initialize();
    }
})();
